<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Internal/debug builds only: allows the in-app OTA updater to hand an APK to the
         package installer. Google Play forbids REQUEST_INSTALL_PACKAGES for store-distributed
         builds, so this permission must never move back into src/main/AndroidManifest.xml. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
</manifest>
