# ── ThaibaHive Production & Staging Environment Template ─────────────────

# ── 1. Production Database (PostgreSQL / Supabase) ──────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_change_me
POSTGRES_DB=thaibahive
DATABASE_URL=postgres://postgres:secure_postgres_password_change_me@postgres:5432/thaibahive

# ── 2. Security & Auth Credentials ──────────────────────────────────────────
JWT_SECRET=production_jwt_secret_must_be_at_least_32_bytes_long_change_me
HEALTH_SECRET=production_health_check_secret_header_token

# ── 3. FCM Push Notifications (Firebase Admin SDK) ──────────────────────────
FIREBASE_PROJECT_ID=thaibahive-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@thaibahive-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRODUCTION_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ── 4. Email Service (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_123456789_production_key
EMAIL_FROM=noreply@thaibahive.com

# ── 5. Application Host URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://thaibahive.com
