{
  "framework": "soc2",
  "version": "1.0",
  "rules": [
    {
      "id": "soc2-01",
      "description": "Data Handling",
      "dataSource": "db",
      "predicate": "has_encryption",
      "severity": "high",
      "remediationGuidance": "Encrypt data at rest"
    },
    {
      "id": "soc2-02",
      "description": "Access Control",
      "dataSource": "iam",
      "predicate": "has_mfa",
      "severity": "critical",
      "remediationGuidance": "Enable MFA"
    },
    {
      "id": "soc2-03",
      "description": "Audit Logging",
      "dataSource": "logs",
      "predicate": "log_retention > 90",
      "severity": "medium",
      "remediationGuidance": "Increase log retention"
    },
    {
      "id": "soc2-04",
      "description": "Retention Policy",
      "dataSource": "db",
      "predicate": "retention_period <= max_allowed",
      "severity": "low",
      "remediationGuidance": "Update retention policy"
    },
    {
      "id": "soc2-05",
      "description": "Breach Notification",
      "dataSource": "policy",
      "predicate": "has_notification_plan",
      "severity": "high",
      "remediationGuidance": "Create a breach notification plan"
    }
  ]
}