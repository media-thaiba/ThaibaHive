# ThaibaHive Production Environment Configuration
# Copy to .env.production and fill in real values

# ============================================================
# SMS GATEWAY CONFIGURATION
# ============================================================
# Provider: Any REST-based SMS gateway (Twilio, MSG91, etc.)
SMS_GATEWAY_API_URL=https://api.your-sms-provider.com/v1/send
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_GATEWAY_SENDER_ID=THAIBA
SMS_GATEWAY_MAX_RETRIES=3
SMS_GATEWAY_TIMEOUT_MS=5000

# ============================================================
# REDIS CLUSTER CONFIGURATION
# ============================================================
# Production Redis Cluster (comma-separated host:port pairs)
REDIS_CLUSTER_NODES=redis-node-1:7001,redis-node-2:7002,redis-node-3:7003
REDIS_CLUSTER_PASSWORD=your_redis_cluster_password_here
REDIS_CLUSTER_TLS=true

# Single Redis URL (for development or single-instance prod)
REDIS_URL=redis://localhost:6379

# ============================================================
# FCM / APNs PUSH NOTIFICATIONS
# ============================================================
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
APNS_KEY_ID=your_apple_push_notification_key_id
APNS_TEAM_ID=your_apple_developer_team_id
APNS_KEY_PATH=/run/secrets/apns_auth_key.p8
APNS_PRODUCTION=true

# ============================================================
# DATABASE (Supabase PostgreSQL / Pooler)
# ============================================================
# Vercel Runtime: Supabase Transaction Pooler (port 6543)
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# CI / Migrations / Backups: Supabase Session Pooler (port 5432)
DIRECT_DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Max connection pool size per serverless lambda instance (default 3 on Vercel)
DB_POOL_MAX=3
DB_SSL=true

# ============================================================
# SUPABASE STORAGE & CLIENT SDK
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
STORAGE_BUCKET_NAME=uploads

# ============================================================
# AUTH & SECURITY
# ============================================================
# Canonical JWT signing secret (at least 32 chars). REQUIRED in production.
AUTH_JWT_SECRET=your_jwt_secret_at_least_32_chars_long_here
# Legacy alias (deprecated) - only set if migrating from JWT_SECRET:
# JWT_SECRET=your_legacy_jwt_secret_here

# Internal monitoring & maintenance secrets (min 16 chars each)
HEALTH_SECRET=your_health_probe_secret_at_least_16_chars
METRICS_SECRET=your_metrics_scrape_secret_at_least_16_chars
SYSTEM_UPDATE_SECRET=your_system_update_secret_at_least_16_chars
CRON_SECRET=your_cron_execution_secret_at_least_16_chars

# Data & Receipt Cryptographic Keys (min 32 chars each)
PII_ENCRYPTION_KEY=your_pii_field_encryption_key_at_least_32_chars
RECEIPT_SIGNING_KEY=your_receipt_signing_key_at_least_32_chars
RECEIPT_SIGNING_SECRET=your_receipt_signing_secret_at_least_32_chars
PAYMENT_ENCRYPTION_KEY=your_payment_encryption_key_at_least_32_chars
DOC_SIGNING_SECRET=your_doc_signing_secret_at_least_32_chars
EVENT_TICKET_KEY=your_event_ticket_key_at_least_32_chars
ENGAGE_AUTH_SECRET=your_engage_auth_secret_at_least_32_chars
VISITOR_HMAC_SECRET=your_visitor_hmac_secret_at_least_32_chars
HEALER_SECRET=your_healer_secret_at_least_32_chars
MDM_ENROLLMENT_TOKEN=your_enterprise_mdm_enrollment_token_here

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-domain.com

# ============================================================
# PAYMENTS & WEBHOOKS (Required if ENABLE_PAYMENTS=true)
# ============================================================
# ENABLE_PAYMENTS=true
# RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_at_least_16_chars
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_at_least_16_chars
# STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_at_least_16_chars
# ENGAGE_WEBHOOK_SECRET=your_engage_webhook_secret_at_least_16_chars

# ============================================================
# APP & OBSERVABILITY
# ============================================================
APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com
SENTRY_DSN=https://example@sentry.io/your-dsn
# APM_TELEMETRY_ENABLED=true
